{
  "name": "workspace-plugin-plotly",
  "version": "2.5.0",
  "private": true,
  "description": "A FINOS Workspace widget plugin that draws any backend's Plotly figure with plotly.js",
  "author": "dlee-bq",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "verify": "node ../scripts/verify.mjs",
    "install:workspace": "node ../scripts/install.mjs",
    "dev:workspace": "node ../scripts/sync-dev.mjs",
    "test": "node --test",
    "e2e": "playwright test -c e2e/playwright.config.mjs e2e/plotly.spec.mjs e2e/kinds.spec.mjs",
    "e2e:figures": "playwright test -c e2e/playwright.config.mjs e2e/all-figures.spec.mjs"
  },
  "dependencies": {
    "mathjax": "4.1.3",
    "plotly.js-strict-dist-min": "4.3.0",
    "sane-topojson": "4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2"
  }
}
