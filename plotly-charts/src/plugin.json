{
  "manifestVersion": 1,
  "id": "plotly-charts",
  "name": "Plotly charts",
  "description": "Renders the plotly widget type with plotly.js: any backend's Plotly figure, drawn as its author made it.",
  "publisher": {
    "name": "dlee-bq"
  },
  "icon": "assets/icon.svg",
  "host": {
    "api": 1,
    "afm": "0.11"
  },
  "entry": {
    "module": "entry.js",
    "styles": [
      "entry.css"
    ]
  },
  "contributes": {
    "widgets": [
      {
        "id": "chart",
        "name": "Plotly chart",
        "description": "A backend's Plotly figure, drawn with plotly.js",
        "category": "Charts",
        "handles": [
          {
            "type": "plotly",
            "response": {
              "accepts": "json",
              "description": "A Plotly figure as JSON, {\"data\": [traces], \"layout\": {...}, \"frames\": [...]}, as plotly.py's fig.to_json() writes it. The endpoint gets theme=dark or theme=light."
            },
            "definition": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "modebar": {
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "artifact": {
          "description": "A chart drawn with Plotly.js from a figure you give it, as plotly.js takes one: {data: [traces], layout, frames}. Use it for a chart of any kind, from bars, lines and pies to maps, heatmaps and 3D. The user can add it to a dashboard.",
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/value"
                  }
                }
              },
              "layout": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/value"
                }
              },
              "frames": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/value"
                  }
                }
              }
            },
            "$defs": {
              "value": {
                "type": [
                  "string",
                  "number",
