{
  "name": "workspace-plugin-marquee",
  "version": "0.1.0",
  "private": true,
  "description": "A FINOS Workspace widget plugin that scrolls news, prices and announcements as a marquee that updates live",
  "author": "dlee-bq",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "verify": "node ../scripts/verify.mjs",
    "install:workspace": "node ../scripts/install.mjs",
    "dev:workspace": "node ../scripts/sync-dev.mjs",
    "test": "node --test",
    "e2e": "playwright test -c e2e/playwright.config.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.18"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
