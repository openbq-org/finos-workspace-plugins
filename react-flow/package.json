{
  "name": "workspace-plugin-react-flow",
  "version": "1.1.1",
  "private": true,
  "description": "A FINOS Workspace widget plugin that draws editable flow diagrams with React Flow",
  "author": "dlee-bq",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "verify": "node ../scripts/verify.mjs",
    "install:workspace": "node ../scripts/install.mjs",
    "dev:workspace": "node ../scripts/sync-dev.mjs",
    "test": "tsc --noEmit && node --test",
    "e2e": "playwright test -c e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
